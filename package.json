{
  "name": "my-funds-webapp",
  "version": "0.1.0",
  "private": true,
  "description": "个人基金资产看板：分组配置、投顾组合、再平衡提醒、雪球资产证明导入",
  "license": "GPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "vite build && node server/index.js",
    "serve": "node server/index.js",
    "test": "node --test server/*.test.js && vitest run"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "express": "^5.3.0",
    "lucide-react": "^1.72.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.9.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "concurrently": "^10.0.6",
    "echarts": "^6.1.0",
    "jsdom": "^31.0.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
